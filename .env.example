# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# --- Database ---------------------------------------------------------------
# Default is a local SQLite file under data/. Leave unset to use the default.
# DATABASE_URL=sqlite:///./data/patients.db

# --- Vapi -------------------------------------------------------------------
# Private/server API key from Vapi dashboard -> Settings -> API Keys.
# Used only by scripts/vapi_setup.py to create the assistant + tools.
VAPI_PRIVATE_KEY=

# Optional shared secret. If set, Vapi sends it as the `x-vapi-secret` header
# on every webhook and we reject requests that don't match. Recommended once
# the tunnel URL is public.
VAPI_WEBHOOK_SECRET=

# --- App --------------------------------------------------------------------
LOG_LEVEL=INFO
